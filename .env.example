# Copy to .env for local use, or set these in Vercel -> Settings -> Environment Variables.
# Every one of them is optional: with none set, the app runs against a local SQLite
# file at server/banking.db with no access code.

# Hosted Turso database. Set both together, or neither.
#   turso db create banking-demo
#   turso db show banking-demo --url
#   turso db tokens create banking-demo
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared code required by every API request. Unset means the API is open.
# One code for the whole team - it keeps strangers off a public URL, it is not
# per-user authentication.
BANKING_ACCESS_CODE=

# API port for `npm run server` / `npm start` (default 4000).
PORT=

# Local SQLite file, ignored when TURSO_DATABASE_URL is set.
BANKING_DB=

# Where `npm run dev` proxies /api to (default http://localhost:4000).
BANKING_API_URL=
